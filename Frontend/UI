    <!-- JAVASCRIPT CORE LOGIC -->
    <script>
        // --- DATA SAMPLES FOR PROTOTYPE ---
        const sampleData = {
            paddy: {
                crop: 'Paddy (Rice)',
                stage: 'Flowering Stage',
                disease: 'Paddy Blast Disease',
                category: 'Fungal Pathogen',
                severity: 42.5,
                ndvi: 0.34,
                confidence: 96.4,
                imgUrl: 'https://images.unsplash.com/photo-1586771107445-d3ca888129ff?auto=format&fit=crop&w=800&q=80',
                maskPolygon: 'M 10 30 Q 30 10 60 35 T 90 80 L 70 90 L 20 70 Z',
                maskColor: 'rgba(239, 68, 68, 0.4)'
            },
            cotton: {
                crop: 'Cotton Crop',
                stage: 'Boll Formation',
                disease: 'Submerged Waterlogging (Flood)',
                category: 'Abiotic Stress',
                severity: 78.0,
                ndvi: 0.18,
                confidence: 98.1,
                imgUrl: 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=800&q=80',
                maskPolygon: 'M 5 50 Q 50 20 95 60 L 80 95 L 10 90 Z',
                maskColor: 'rgba(59, 130, 246, 0.4)'
            },
            wheat: {
                crop: 'Wheat',
                stage: 'Grain Filling',
                disease: 'Healthy Crop (No Disease)',
                category: 'Optimal Growth',
                severity: 0.0,
                ndvi: 0.82,
                confidence: 99.2,
                imgUrl: 'https://images.unsplash.com/photo-1574323347407-f5e1ad6d020b?auto=format&fit=crop&w=800&q=80',
                maskPolygon: 'M 0 0 L 0 0 Z',
                maskColor: 'transparent'
            },
            maize: {
                crop: 'Maize (Corn)',
                stage: 'Vegetative Stage',
                disease: 'Drought-Stressed Wilting',
                category: 'Thermal Stress',
                severity: 61.2,
                ndvi: 0.28,
                confidence: 94.7,
                imgUrl: 'https://images.unsplash.com/photo-1601598851547-4302969d0614?auto=format&fit=crop&w=800&q=80',
                maskPolygon: 'M 20 20 L 80 15 L 85 85 L 15 80 Z',
                maskColor: 'rgba(217, 119, 6, 0.4)'
            }
        };

        let currentActiveData = sampleData.paddy;

        // --- INIT ON LOAD ---
        window.onload = function () {
            loadSample('paddy');
            initCharts();
        };

        // --- LOAD PRESET SAMPLES ---
        function loadSample(key) {
            currentActiveData = sampleData[key];

            // Update Preview Image
            const imgEl = document.getElementById('previewImage');
            imgEl.src = currentActiveData.imgUrl;

            // Reset SVG overlay mask
            renderSvgMask(currentActiveData.maskPolygon, currentActiveData.maskColor);

            // Directly calculate and render
            updateDiagnosisUI();
        }

        // --- HANDLE FILE UPLOAD ---
        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('previewImage').src = e.target.result;
                    // Mock data for custom upload
                    currentActiveData = {
                        crop: 'Custom Upload Crop',
                        stage: 'Detected Stage',
                        disease: 'Custom Leaf Spot Detected',
                        category: 'Pathogen Analysis',
                        severity: Math.floor(Math.random() * 45) + 15,
                        ndvi: (Math.random() * 0.4 + 0.3).toFixed(2),
                        confidence: 92.5,
                        maskPolygon: 'M 15 15 L 75 25 L 65 75 L 25 65 Z',
                        maskColor: 'rgba(239, 68, 68, 0.4)'
                    };
                    renderSvgMask(currentActiveData.maskPolygon, currentActiveData.maskColor);
                    runAiAnalytics();
                };
                reader.readAsDataURL(file);
            }
        }

        // --- RENDER SVG MASK OVERLAY ---
        function renderSvgMask(path, strokeFill) {
            const svg = document.getElementById('aiSegmentationMask');
            svg.innerHTML = strokeFill !== 'transparent' ?
                `<path d="${path}" fill="${strokeFill}" stroke="#ef4444" stroke-width="0.8" stroke-dasharray="2,2" />` : '';
        }

        // --- SIMULATE AI SCANNING ANIMATION ---
        function runAiAnalytics() {
            const overlay = document.getElementById('scannerOverlay');
            const stepText = document.getElementById('scanStepText');
            const statusBadge = document.getElementById('aiStatusBadge');
            const runBtn = document.getElementById('runAiBtn');

            overlay.classList.remove('hidden');
            statusBadge.className = "text-[10px] bg-yellow-100 text-yellow-800 font-bold px-2 py-0.5 rounded-full border border-yellow-200";
            statusBadge.innerText = "Processing AI Model...";
            runBtn.disabled = true;
            runBtn.classList.add('opacity-50');

            // Sequence of AI pipeline stages
            setTimeout(() => { stepText.innerText = "1/3 Preprocessing & RGB to NDVI Conversion..."; }, 600);
            setTimeout(() => { stepText.innerText = "2/3 Running ResNet-50 Disease Classification..."; }, 1400);
            setTimeout(() => { stepText.innerText = "3/3 Calculating Damage Area Percentage & Sum Insured..."; }, 2100);

            setTimeout(() => {
                overlay.classList.add('hidden');
                statusBadge.className = "text-[10px] bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full border border-emerald-200";
                statusBadge.innerText = "Analysis Complete";
                runBtn.disabled = false;
                runBtn.classList.remove('opacity-50');

                updateDiagnosisUI();
            }, 2700);
        }

        // --- UPDATE DIAGNOSIS & PMFBY CALCULATION UI ---
        function updateDiagnosisUI() {
            const area = parseFloat(document.getElementById('plotArea').value) || 2.5;
            const sumInsured = parseFloat(document.getElementById('sumInsured').value) || 52000;

            const severity = currentActiveData.severity;
            const affectedHa = ((area * severity) / 100).toFixed(2);

            // PMFBY Pro-Rata Claim Calculation Formula
            // Compensation = Area (Ha) * Sum Insured (Rs/Ha) * (Severity / 100)
            const calculatedPayout = Math.round(area * sumInsured * (severity / 100));

            // Populate Text Fields
            document.getElementById('confidenceScore').innerText = currentActiveData.confidence + '%';
            document.getElementById('cropType').innerText = currentActiveData.crop;
            document.getElementById('cropStage').innerText = currentActiveData.stage;
            document.getElementById('detectedState').innerText = currentActiveData.disease;
            document.getElementById('conditionCategory').innerText = currentActiveData.category;

            document.getElementById('severityValue').innerText = severity + '%';
            document.getElementById('severityPercentText').innerText = severity + '%';
            document.getElementById('severityBar').style.width = severity + '%';

            document.getElementById('affectedAreaValue').innerText = `${affectedHa} Hectares`;
            document.getElementById('hudNdvi').innerText = currentActiveData.ndvi;

            // Formatted Currency Payout
            document.getElementById('claimAmountDisplay').innerText = `₹ ${calculatedPayout.toLocaleString('en-IN')}`;

            // Eligibility Badge Dynamic Switch
            const badge = document.getElementById('claimEligibilityBadge');
            if (severity >= 30) {
                badge.className = "inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-600 text-white shadow-sm";
                badge.innerHTML = `<i class="fa-solid fa-circle-check mr-1.5"></i> Eligible for Direct PMFBY Claim`;
            } else if (severity > 0) {
                badge.className = "inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-500 text-white shadow-sm";
                badge.innerHTML = `<i class="fa-solid fa-triangle-exclamation mr-1.5"></i> Below Claim Threshold (Min 30%)`;
            } else {
                badge.className = "inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-500 text-white shadow-sm";
                badge.innerHTML = `<i class="fa-solid fa-shield-halved mr-1.5"></i> Healthy Crop - No Claim`;
            }
        }

        function recalculateClaim() {
            updateDiagnosisUI();
        }

        // --- ROLE SWITCHER HANDLER ---
        function handleRoleChange() {
            const role = document.getElementById('roleSelect').value;
            if (role === 'farmer') {
                alert("Switched to Farmer Interface: Simplified single-click claim request view enabled.");
            } else if (role === 'admin') {
                alert("Switched to PMFBY Claim Officer View: Verification controls and batch approvals unlocked.");
            } else {
                alert("Switched to Field Surveyor View: Full AI Diagnostic and EXIF verification active.");
            }
        }

        // --- MODAL TOGGLES ---
        function toggleGuideModal() {
            const modal = document.getElementById('guideModal');
            modal.classList.toggle('hidden');
        }

        function toggleTicketModal() {
            const modal = document.getElementById('ticketModal');
            modal.classList.toggle('hidden');
        }

        function generateClaimTicket() {
            const area = parseFloat(document.getElementById('plotArea').value) || 2.5;
            const sumInsured = parseFloat(document.getElementById('sumInsured').value) || 52000;
            const calculatedPayout = Math.round(area * sumInsured * (currentActiveData.severity / 100));

            document.getElementById('rptCropDisease').innerText = `${currentActiveData.crop} / ${currentActiveData.disease}`;
            document.getElementById('rptSeverity').innerText = `${currentActiveData.severity}%`;
            document.getElementById('rptArea').innerText = `${area} Hectares`;
            document.getElementById('rptPayout').innerText = `₹ ${calculatedPayout.toLocaleString('en-IN')}`;

            const now = new Date();
            document.getElementById('rptDate').innerText = now.toLocaleString('en-IN');

            toggleTicketModal();
        }

        function simulateGovernmentSync() {
            alert("✓ Success: Geo-tagged AI Damage Payload successfully signed and transmitted to National Crop Insurance Portal (NCIP) Gateway!");
        }

        function downloadJSON() {
            const area = parseFloat(document.getElementById('plotArea').value) || 2.5;
            const sumInsured = parseFloat(document.getElementById('sumInsured').value) || 52000;
            const calculatedPayout = Math.round(area * sumInsured * (currentActiveData.severity / 100));

            const reportData = {
                claim_ticket_id: "PMFBY-2026-88491",
                timestamp: new Date().toISOString(),
                farmer_id: "PMFBY-TEL-88491",
                geo_tagging: {
                    latitude: 17.3850,
                    longitude: 78.4867,
                    location: "Medak, Telangana"
                },
                crop_ai_analysis: currentActiveData,
                financials: {
                    insured_ha: area,
                    sum_insured_per_ha: sumInsured,
                    final_payout_inr: calculatedPayout
                }
            };

            const blob = new Blob([JSON.stringify(reportData, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `PMFBY_Claim_Report_88491.json`;
            a.click();
            URL.revokeObjectURL(url);
        }

        // --- CHART.JS INITIALIZATION FOR DISTRICT ANALYTICS ---
        function initCharts() {
            // Chart 1: Damage Types
            const ctx1 = document.getElementById('chartDamageType').getContext('2d');
            new Chart(ctx1, {
                type: 'doughnut',
                data: {
                    labels: ['Paddy Blast Disease', 'Flood / Waterlogging', 'Drought Stress', 'Healthy / No Loss'],
                    datasets: [{
                        data: [42, 28, 18, 12],
                        backgroundColor: ['#ef4444', '#3b82f6', '#f59e0b', '#22c55e'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } }
                    }
                }
            });

            // Chart 2: Monthly Claims
            const ctx2 = document.getElementById('chartClaimMonthly').getContext('2d');
            new Chart(ctx2, {
                type: 'bar',
                data: {
                    labels: ['Jul', 'Aug', 'Sep', 'Oct', 'Nov'],
                    datasets: [{
                        label: 'Claims Submitted (₹ Lakhs)',
                        data: [12.4, 28.6, 45.2, 38.0, 19.5],
                        backgroundColor: '#10b981',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { ticks: { font: { size: 10 } } },
                        x: { ticks: { font: { size: 10 } } }
                    }
                }
            });

            // Chart 3: Efficiency Gain
            const ctx3 = document.getElementById('chartEfficiency').getContext('2d');
            new Chart(ctx3, {
                type: 'line',
                data: {
                    labels: ['Traditional Survey', 'Drone Image AI', 'Mobile AI PMFBY System'],
                    datasets: [{
                        label: 'Days to Settle Claim',
                        data: [45, 12, 3],
                        borderColor: '#6366f1',
                        backgroundColor: 'rgba(99, 102, 241, 0.1)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { title: { display: true, text: 'Days', font: { size: 10 } } }
                    }
                }
            });
        }
    </script>
